<Application x:Class="MirrorsEdgeMapManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MirrorsEdgeMapManager.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <materialDesign:CustomColorTheme BaseTheme="Light"
                                                 PrimaryColor="#cd2129"
                                                 SecondaryColor="Red" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme brushes -->
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#cd2129" />
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#b71c1c" />
            <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#e57373" />
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#FFFFFF" />

            <Color x:Key="MaterialDesign.Primary.Foreground">#FFFFFF</Color>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground"
                             Color="{StaticResource MaterialDesign.Primary.Foreground}" />

            <Style TargetType="ScrollBar" x:Key="ModernScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Opacity" Value="0.7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="true"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Stretch">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineUpCommand"
                                                      Style="{x:Null}"
                                                      Height="0" Width="0"/>
                                    </Track.DecreaseRepeatButton>

                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="#666"
                                                            CornerRadius="4"
                                                            Opacity="0.5"
                                                            Margin="2">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4"
                                                                              Opacity="0.2"
                                                                              ShadowDepth="0"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource PrimaryHueMidBrush}" />
                                                            <Setter TargetName="ThumbBorder"
                                                                    Property="Opacity"
                                                                    Value="0.9" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource PrimaryHueDarkBrush}" />
                                                            <Setter TargetName="ThumbBorder"
                                                                    Property="Opacity"
                                                                    Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineDownCommand"
                                                      Style="{x:Null}"
                                                      Height="0" Width="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Converters -->
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis"/>
            <converters:BoolToCollapsedHeightConverter x:Key="BoolToCollapsedHeight"/>

            <!-- DataGrid Cell Style -->
            <Style x:Key="MapDataGridCellStyle" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="8,4">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- DataGrid Row Style -->
            <Style x:Key="MapDataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFECEC"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

